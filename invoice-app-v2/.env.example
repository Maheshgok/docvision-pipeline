# Invoice Processing App Environment Variables
# 
# IMPORTANT: All variables prefixed with VITE_ are embedded into the client-side 
# JavaScript bundle and are publicly visible. Do NOT put sensitive secrets here.
# Use Netlify environment variables for server-side secrets without the VITE_ prefix.

# Firebase Web App Configuration (Client-side - publicly visible)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com        
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=G-MEASUREMENT_ID

# API Configuration (Client-side - publicly visible)
VITE_API_BASE_URL=https://your-api-url.com
VITE_QUEUE_API_URL=https://your-queue-api-url.com

# Cloud Run Services (Project ID: 812016027146) - New Modern Pipeline
VITE_ORCHESTRATOR_SERVICE_URL=https://orchestrator-service-812016027146.asia-south1.run.app
VITE_DATA_EXTRACTOR_SERVICE_URL=https://data-extractor-v2-812016027146.asia-south1.run.app  
VITE_CHUNK_DISPATCHER_SERVICE_URL=https://chunk-dispatcher-812016027146.asia-south1.run.app
VITE_FIELD_STANDARDIZER_SERVICE_URL=https://field-standardizer-v2-812016027146.asia-south1.run.app
VITE_DATA_COMBINER_SERVICE_URL=https://data-combiner-v2-812016027146.asia-south1.run.app

# Legacy Services (Optional - for backward compatibility)
VITE_INITIAL_API_URL=https://initial-api-812016027146.asia-south1.run.app
VITE_ARCHIVE_API_URL=https://archive-manager-812016027146.asia-south1.run.app
VITE_QUEUE_PROCESSOR_URL=https://queue-processor-812016027146.asia-south1.run.app

# Google OAuth (Client-side - publicly visible)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# App Configuration (Client-side - publicly visible)
VITE_APP_NAME=Invoice Processing App
VITE_APP_VERSION=2.0.0
VITE_ENVIRONMENT=development

# Server-side secrets (Set these in Netlify dashboard - NOT in this file)
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# FIREBASE_ADMIN_PRIVATE_KEY=your_firebase_admin_private_key_here
# OPENAI_API_KEY=your_openai_api_key_here
