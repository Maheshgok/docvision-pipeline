# ===============================================
# NETLIFY DEPLOYMENT ENVIRONMENT VARIABLES
# ===============================================
# Copy these to your Netlify dashboard > Site settings > Environment variables

# ============= FIREBASE FRONTEND CONFIG =============
# These are safe to expose in the frontend
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ============= FIREBASE ADMIN (FUNCTIONS) CONFIG =============
# SENSITIVE: For Netlify Functions only - DO NOT expose these
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=your_private_key_content_without_begin_end_markers
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_CLIENT_ID=your_client_id

# ============= API CONFIGURATION =============
VITE_API_BASE_URL=https://your-site-name.netlify.app/.netlify/functions
VITE_PROCESSING_ENDPOINT=/process-invoice

# ============= CLOUD RUN SERVICES =============
# Project ID: 812016027146
VITE_INITIAL_API_URL=https://initial-api-812016027146.asia-south1.run.app
VITE_ARCHIVE_API_URL=https://archive-manager-812016027146.asia-south1.run.app
VITE_QUEUE_PROCESSOR_URL=https://queue-processor-812016027146.asia-south1.run.app

# ============= APP CONFIGURATION =============
VITE_APP_NAME=Invoice Processor v2
VITE_MAX_FILE_SIZE=10485760
VITE_SUPPORTED_FORMATS=image/*,application/pdf

# ============= BUILD CONFIGURATION =============
NODE_VERSION=18
NPM_FLAGS=--prefer-offline --no-audit